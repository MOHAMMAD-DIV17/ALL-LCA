#include <stdio.h>
#include <stdlib.h>
#include <time.h>

/* Returns 1 if year is a leap year under Gregorian rules, else 0 */
int is_leap_year(int year) {
    if ((year % 400 == 0) || (year % 4 == 0 && year % 100 != 0)) {
        return 1;
    }
    return 0;
}

/* Returns the number of days in a given month (1-12) for a given year */
int get_days_in_month(int month, int year) {
    switch (month) {
        case 1: case 3: case 5: case 7: case 8: case 10: case 12:
            return 31;
        case 4: case 6: case 9: case 11:
            return 30;
        case 2:
            return is_leap_year(year) ? 29 : 28;
        default:
            return 0;
    }
}

/* Uses <time.h> to get the day of the week (0 = Sunday, 1 = Monday, ..., 6 = Saturday)
   for January 1st of the given year */
int get_jan1_weekday(int year) {
    struct tm time_info = {0};
    time_info.tm_year = year - 1900; /* Years since 1900 */
    time_info.tm_mon = 0;            /* January (0-11) */
    time_info.tm_mday = 1;           /* 1st of the month */
    time_info.tm_isdst = -1;         /* Let system determine DST */

    mktime(&time_info);
    return time_info.tm_wday;
}

void print_calendar(int year) {
    const char *months[] = {
        "January", "February", "March", "April",
        "May", "June", "July", "August",
        "September", "October", "November", "December"
    };

    int start_day = get_jan1_weekday(year);

    printf("\n========================================\n");
    printf("              CALENDAR %d\n", year);
    printf("========================================\n");

    for (int month = 1; month <= 12; month++) {
        int days = get_days_in_month(month, year);

        printf("\n------------ %s %d ------------\n", months[month - 1], year);
        printf("Sun  Mon  Tue  Wed  Thu  Fri  Sat\n");

        /* Print leading spaces for the first day of the month */
        for (int i = 0; i < start_day; i++) {
            printf("     ");
        }

        /* Print all days of the month */
        for (int day = 1; day <= days; day++) {
            printf("%3d  ", day);
            start_day = (start_day + 1) % 7;
            if (start_day == 0) {
                printf("\n");
            }
        }

        /* Ensure next month starts on a fresh line */
        if (start_day != 0) {
            printf("\n");
        }
    }
}

int main(void) {
    int year;

    printf("Enter the year: ");
    if (scanf("%d", &year) != 1 || year < 1) {
        fprintf(stderr, "Invalid input. Please enter a valid positive year.\n");
        return EXIT_FAILURE;
    }

    print_calendar(year);
    return EXIT_SUCCESS;
}
